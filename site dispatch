        function handleCreateNewRole(e) {
            e.preventDefault();
            const roleCode = document.getElementById('new-role-code').value.trim().toUpperCase().replace(/\s+/g, '_');
            const roleLabel = document.getElementById('new-role-label').value.trim();
            const roleColor = document.getElementById('new-role-color').value;
            const accessRadio = document.querySelector('input[name="new-role-access"]:checked');
            const isFullAccess = accessRadio ? (accessRadio.value === 'full') : false;

            if (!roleCode || !roleLabel) {
                showToast('Code et libellé du rôle obligatoires.', 'error');
                return;
            }

            let roleNames = getRoleNames();
            let roleColors = getRoleColors();
            let rolePerms = getRolePermissions();

            if (roleNames[roleCode]) {
                showToast(`Le rôle '${roleCode}' existe déjà.`, 'error');
                return;
            }

            roleNames[roleCode] = roleLabel;
            roleColors[roleCode] = roleColor;
            rolePerms[roleCode] = isFullAccess;

            saveRoleNames(roleNames);
            saveRoleColors(roleColors);
            saveRolePermissions(rolePerms);

            document.getElementById('new-role-code').value = '';
            document.getElementById('new-role-label').value = '';
            document.getElementById('new-role-color').value = '#3b82f6';

            addLog('CREAT_ROLE', `Création du rôle : ${roleCode} ("${roleLabel}") | Accès: ${isFullAccess ? 'Total' : 'Agent'}`);
            showToast(`Rôle '${roleLabel}' créé avec succès.`, 'success');

            renderAdminSpace();
        }

        function deleteCustomRole(roleKey) {
            if (roleKey === 'AGENT' || roleKey === 'LEAD' || roleKey === 'COLEAD') {
                showToast('Impossible de supprimer les rôles de base du système.', 'error');
                return;
            }

            openConfirmModal('Supprimer le rôle', `Voulez-vous vraiment supprimer le rôle '${roleKey}' ?`, () => {
                let roleNames = getRoleNames();
                let roleColors = getRoleColors();
                let rolePerms = getRolePermissions();

                delete roleNames[roleKey];
                delete roleColors[roleKey];
                delete rolePerms[roleKey];

                saveRoleNames(roleNames);
                saveRoleColors(roleColors);
                saveRolePermissions(rolePerms);

                addLog('SUPPR_ROLE', `Suppression du rôle personnalisé : ${roleKey}`);
                showToast(`Rôle ${roleKey} supprimé.`, 'info');

                renderAdminSpace();
            });
        }

        function handleSaveRoleNames(e) {
            e.preventDefault();
            const labelInputs = document.querySelectorAll('.role-label-input');
            const colorInputs = document.querySelectorAll('.role-color-input');
            const permSelects = document.querySelectorAll('.role-perm-select');

            const updatedRoles = {};
            const updatedColors = {};
            const updatedPerms = {};

            labelInputs.forEach(input => {
                const key = input.getAttribute('data-role-key');
                const val = input.value.trim();
                if (val) updatedRoles[key] = val;
            });

            colorInputs.forEach(input => {
                const key = input.getAttribute('data-role-color-key');
                const val = input.value;
                if (val) updatedColors[key] = val;
            });

            permSelects.forEach(sel => {
                const key = sel.getAttribute('data-role-perm-key');
                const val = (sel.value === 'true');
                updatedPerms[key] = val;
            });

            saveRoleNames(updatedRoles);
            saveRoleColors(updatedColors);
            saveRolePermissions(updatedPerms);

            addLog('CONFIG_ROLES', `Intitulés, couleurs et permissions des rôles mis à jour.`);
            showToast('Intitulés, couleurs et permissions enregistrés !', 'success');

            if (currentUser) {
                document.getElementById('user-display-role').innerText = `Matricule: ${currentUser.matricule} | Rôle: ${getRoleLabel(currentUser.role)}`;
            }

            renderAdminSpace();
        }

        function clearLogs() {
            openConfirmModal('Effacer les logs', 'Voulez-vous vraiment effacer tout le journal d\'activités ?', () => {
                saveLogs([]);
                renderLogsSpace();
                showToast('Journal des logs effacé.', 'info');
