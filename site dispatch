        function handleSaveAgent(e) {
            e.preventDefault();
            const matriculeInput = document.getElementById('agent-form-matricule');
            const matricule = matriculeInput.value.trim().toUpperCase();
            const name = document.getElementById('agent-form-name').value.trim();
            const role = document.getElementById('agent-form-role').value;

            if (!matricule || !name) {
                showToast('Matricule et nom obligatoires.', 'error');
                return;
            }

            let agents = getAgents();
            const existingIndex = agents.findIndex(a => a.matricule.toUpperCase() === matricule);

            if (existingIndex >= 0) {
                agents[existingIndex] = { matricule, name, role };
                addLog('MODIF_AGENT', `Agent mis à jour : ${name} (${matricule}) sous rôle ${role}`);
                showToast(`Agent ${name} mis à jour avec succès.`, 'success');
            } else {
                agents.push({ matricule, name, role });
                addLog('AJOUT_AGENT', `Nouvel agent ajouté : ${name} (${matricule}) sous rôle ${role}`);
                showToast(`Agent ${name} ajouté à l'effectif.`, 'success');
            }

            saveAgents(agents);
            matriculeInput.value = '';
            matriculeInput.readOnly = false;
            document.getElementById('agent-form-name').value = '';
            
            const formTitle = document.querySelector('#admin-subtab-agents .lg\\:col-span-1 h3');
            if (formTitle) formTitle.innerHTML = '<i class="fa-solid fa-user-plus text-brand-500"></i> Ajouter / Modifier un Agent';

            renderAdminSpace();
        }

        function deleteAgent(matricule) {
            const activeMatricule = originalLeadUser ? originalLeadUser.matricule : (currentUser ? currentUser.matricule : null);
            if (activeMatricule && matricule === activeMatricule) {
                showToast('Vous ne pouvez pas supprimer votre propre compte connecté !', 'error');
                return;
            }

            let agents = getAgents();
            const agentToDelete = agents.find(a => a.matricule === matricule);
            if (!agentToDelete) {
                showToast('Agent introuvable.', 'error');
                return;
            }

            openConfirmModal(
                'Supprimer l\'agent',
                `Confirmer la suppression définitive de l'agent ${agentToDelete.name} (${matricule}) ?`,
                () => {
                    agents = agents.filter(a => a.matricule !== matricule);
                    saveAgents(agents);

                    let shifts = getShifts();
                    shifts = shifts.filter(s => s.matricule !== matricule);
                    saveShifts(shifts);

                    addLog('SUPPR_AGENT', `Agent ${agentToDelete.name} (${matricule}) supprimé définitivement.`);
                    showToast(`Agent ${agentToDelete.name} supprimé de l'effectif.`, 'info');

                    renderAdminSpace();
                }
            );
        }

        function inspectAgentShifts(matricule) {
            const agents = getAgents();
            const agent = agents.find(a => a.matricule === matricule);
            if (!agent) return;

            if (!originalLeadUser && currentUser) {
                originalLeadUser = currentUser;
            }

            currentUser = agent;
            document.getElementById('user-display-name').innerHTML = `${agent.name} <span class="text-xs text-amber-400 font-normal">(Mode Inspection)</span>`;
            switchTab('my-space');
            showToast(`Consultation de la fiche de : ${agent.name}`, 'info');
        }

