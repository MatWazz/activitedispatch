                        <select data-role-perm-key="${roleKey}" ${isBaseRole && (roleKey === 'LEAD' || roleKey === 'COLEAD') ? 'disabled' : ''}
                            class="role-perm-select bg-dark-900 border border-gray-700 rounded-xl px-3 py-2 text-white text-xs focus:outline-none focus:border-brand-500">
