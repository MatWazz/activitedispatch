    <script>
        const STORAGE_KEY_AGENTS = 'dispatch_agents_v1';
        const STORAGE_KEY_SHIFTS = 'dispatch_shifts_v1';
        const STORAGE_KEY_LOGS = 'dispatch_logs_v1';
        const STORAGE_KEY_ROLE_NAMES = 'dispatch_role_names_v1';
        const STORAGE_KEY_ROLE_COLORS = 'dispatch_role_colors_v1';
        const STORAGE_KEY_ROLE_PERMS = 'dispatch_role_perms_v1';

        const DEFAULT_AGENTS = [
            { matricule: '101', name: 'John Miller', role: 'AGENT' },
            { matricule: '102', name: 'Sarah Connor', role: 'AGENT' },
            { matricule: '103', name: 'Alex Murphy', role: 'AGENT' },
            { matricule: 'LEAD01', name: 'Marcus Vance', role: 'LEAD' },
            { matricule: 'COLEAD01', name: 'Elena Rostova', role: 'COLEAD' }
        ];

        const DEFAULT_ROLE_NAMES = {
            AGENT: 'Dispatcher',
            LEAD: 'Lead Dispatcher',
            COLEAD: 'Co-Lead Dispatcher'
        };

        const DEFAULT_ROLE_COLORS = {
            AGENT: '#3b82f6',
            LEAD: '#f59e0b',
            COLEAD: '#8b5cf6'
        };

        const DEFAULT_ROLE_PERMS = {
            AGENT: false,  // false = standard agent access only
            LEAD: true,    // true = full admin access
            COLEAD: true   // true = full admin access
        };

        let currentUser = null;
        let originalLeadUser = null;
        let currentWeekOffset = 0;

        function getRoleNames() {
            const data = localStorage.getItem(STORAGE_KEY_ROLE_NAMES);
            return data ? JSON.parse(data) : DEFAULT_ROLE_NAMES;
        }

        function saveRoleNames(roles) {
            localStorage.setItem(STORAGE_KEY_ROLE_NAMES, JSON.stringify(roles));
        }

        function getRoleColors() {
            const data = localStorage.getItem(STORAGE_KEY_ROLE_COLORS);
            return data ? JSON.parse(data) : DEFAULT_ROLE_COLORS;
        }

        function saveRoleColors(colors) {
            localStorage.setItem(STORAGE_KEY_ROLE_COLORS, JSON.stringify(colors));
        }

        function getRolePermissions() {
            const data = localStorage.getItem(STORAGE_KEY_ROLE_PERMS);
            return data ? JSON.parse(data) : DEFAULT_ROLE_PERMS;
        }

        function saveRolePermissions(perms) {
            localStorage.setItem(STORAGE_KEY_ROLE_PERMS, JSON.stringify(perms));
        }

        function hasFullAccess(roleKey) {
            const perms = getRolePermissions();
            if (roleKey === 'LEAD' || roleKey === 'COLEAD') return true;
            return !!perms[roleKey];
        }

        function getRoleLabel(roleKey) {
            const names = getRoleNames();
            return names[roleKey] || roleKey;
        }

        function getRoleColor(roleKey) {
            const colors = getRoleColors();
            return colors[roleKey] || '#3b82f6';
        }

        function renderRoleBadgeHtml(roleKey) {
            const label = getRoleLabel(roleKey);
            const hex = getRoleColor(roleKey);
            const isFull = hasFullAccess(roleKey);
            const accessIcon = isFull ? ' <i class="fa-solid fa-crown text-[9px] ml-1" title="Accès Total"></i>' : '';
            return `<span class="px-2 py-0.5 rounded text-[10px] font-bold border inline-flex items-center gap-1" style="background-color: ${hex}20; color: ${hex}; border-color: ${hex}50;">${label}${accessIcon}</span>`;
        }

        // Custom Modal Confirmation Helper replacing confirm()
        function openConfirmModal(title, message, onConfirm) {
            const modal = document.getElementById('confirm-modal');
            const titleEl = document.getElementById('confirm-modal-title');
            const msgEl = document.getElementById('confirm-modal-msg');
            const btnCancel = document.getElementById('confirm-modal-cancel');
            const btnConfirm = document.getElementById('confirm-modal-btn');

            titleEl.innerText = title;
            msgEl.innerText = message;

            modal.classList.remove('hidden');

            const cleanup = () => {
                modal.classList.add('hidden');
                btnConfirm.onclick = null;
                btnCancel.onclick = null;
            };

            btnCancel.onclick = cleanup;
            btnConfirm.onclick = () => {
                cleanup();
                onConfirm();
            };
        }

        function getAgents() {
            const data = localStorage.getItem(STORAGE_KEY_AGENTS);
            return data ? JSON.parse(data) : DEFAULT_AGENTS;
        }

        function saveAgents(agents) {
            localStorage.setItem(STORAGE_KEY_AGENTS, JSON.stringify(agents));
        }

        function getShifts() {
            const data = localStorage.getItem(STORAGE_KEY_SHIFTS);
            return data ? JSON.parse(data) : generateMockShifts();
        }

        function saveShifts(shifts) {
            localStorage.setItem(STORAGE_KEY_SHIFTS, JSON.stringify(shifts));
        }

        function getLogs() {
            const data = localStorage.getItem(STORAGE_KEY_LOGS);
            return data ? JSON.parse(data) : [];
        }

        function saveLogs(logs) {
            localStorage.setItem(STORAGE_KEY_LOGS, JSON.stringify(logs));
        }

        function addLog(actionType, details) {
            const logs = getLogs();
            logs.unshift({
                id: 'log_' + Date.now(),
                timestamp: new Date().toLocaleString('fr-FR'),
                author: currentUser ? currentUser.matricule : 'SYSTEM',
                action: actionType,
                details: details
            });
            saveLogs(logs);
        }

        function generateMockShifts() {
            const today = new Date();
            const formatLocalDate = (d) => d.toISOString().split('T')[0];
            
            const mock = [
                { id: 's1', matricule: '101', date: formatLocalDate(today), startTime: '14:00', endTime: '22:30' },
                { id: 's2', matricule: '101', date: formatLocalDate(new Date(Date.now() - 86400000)), startTime: '18:00', endTime: '23:30' },
                { id: 's3', matricule: '102', date: formatLocalDate(today), startTime: '09:00', endTime: '17:00' },
                { id: 's4', matricule: '102', date: formatLocalDate(today), startTime: '20:00', endTime: '23:30' },
                { id: 's5', matricule: 'LEAD01', date: formatLocalDate(today), startTime: '12:00', endTime: '20:00' }
            ];
            localStorage.setItem(STORAGE_KEY_SHIFTS, JSON.stringify(mock));
            return mock;
        }

        function calculateShiftDetails(startTimeStr, endTimeStr) {
            const [startH, startM] = startTimeStr.split(':').map(Number);
            const [endH, endM] = endTimeStr.split(':').map(Number);

            let startMinutes = startH * 60 + startM;
            let endMinutes = endH * 60 + endM;

            if (endMinutes < startMinutes) {
                endMinutes += 24 * 60;
            }

            const totalMinutes = endMinutes - startMinutes;
            const totalHours = totalMinutes / 60;

            let stdMinutes = 0;
            let nightMinutes = 0;

            for (let m = startMinutes; m < endMinutes; m++) {
                const currentMinuteInDay = m % (24 * 60);
                if (currentMinuteInDay >= 21 * 60 && currentMinuteInDay < 24 * 60) {
                    nightMinutes++;
                } else {
                    stdMinutes++;
                }
            }

            const stdHours = stdMinutes / 60;
            const nightHours = nightMinutes / 60;

            const stdPay = stdHours * 1000;
            const nightPay = nightHours * 2000;
            const totalPay = stdPay + nightPay;

            return {
                totalHours: parseFloat(totalHours.toFixed(2)),
                stdHours: parseFloat(stdHours.toFixed(2)),
                nightHours: parseFloat(nightHours.toFixed(2)),
                stdPay,
                nightPay,
                totalPay
            };
        }

        function getWeekRange(offset = 0) {
            const now = new Date();
            const dayOfWeek = now.getDay();
            const distanceToMonday = (dayOfWeek === 0 ? -6 : 1) - dayOfWeek;
            
            const monday = new Date(now);
            monday.setDate(now.getDate() + distanceToMonday + (offset * 7));
            monday.setHours(0, 0, 0, 0);

            const sunday = new Date(monday);
            sunday.setDate(monday.getDate() + 6);
            sunday.setHours(23, 59, 59, 999);

            return { monday, sunday };
        }

        function formatDateFr(date) {
            return date.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' });
        }

        function isDateInWeek(dateStr, monday, sunday) {
            const d = new Date(dateStr + 'T00:00:00');
            return d >= monday && d <= sunday;
        }

        function setLoginMatricule(mat) {
            document.getElementById('login-matricule').value = mat;
        }

        function handleLogin(e) {
            e.preventDefault();
            const matriculeInput = document.getElementById('login-matricule').value.trim().toUpperCase();
            const agents = getAgents();
            const foundAgent = agents.find(a => a.matricule.toUpperCase() === matriculeInput);

            if (!foundAgent) {
                showToast(`Matricule '${matriculeInput}' non reconnu dans l'effectif autorisé.`, 'error');
                return;
            }

            currentUser = foundAgent;
            originalLeadUser = null;

            document.getElementById('login-section').classList.add('hidden');
            document.getElementById('main-header').classList.remove('hidden');

            const isFull = hasFullAccess(currentUser.role);

            if (isFull) {
                document.getElementById('tab-admin-space').classList.remove('hidden');
                document.getElementById('mobile-tab-admin-space').classList.remove('hidden');
                document.getElementById('tab-logs-space').classList.remove('hidden');
                document.getElementById('mobile-tab-logs-space').classList.remove('hidden');
            } else {
                document.getElementById('tab-admin-space').classList.add('hidden');
                document.getElementById('mobile-tab-admin-space').classList.add('hidden');
                document.getElementById('tab-logs-space').classList.add('hidden');
                document.getElementById('mobile-tab-logs-space').classList.add('hidden');
            }

            document.getElementById('user-display-name').innerHTML = `
                ${currentUser.name} 
                ${isFull ? '<i class="fa-solid fa-crown text-amber-400" title="Accès Supervision"></i>' : ''}
            `;
            document.getElementById('user-display-role').innerText = `Matricule: ${currentUser.matricule} | Rôle: ${getRoleLabel(currentUser.role)}`;

            addLog('CONNEXION', `Connexion de l'agent ${currentUser.name} (${currentUser.matricule})`);
            showToast(`Bienvenue, ${currentUser.name} !`, 'success');

            switchTab('my-space');
        }

        function logout() {
            if (originalLeadUser) {
                currentUser = originalLeadUser;
                originalLeadUser = null;
            }
            addLog('DECO', `Déconnexion de l'agent ${currentUser ? currentUser.name : ''}`);
            currentUser = null;
            originalLeadUser = null;

            document.getElementById('main-header').classList.add('hidden');
            document.getElementById('login-section').classList.remove('hidden');
            document.getElementById('my-space-section').classList.add('hidden');
            document.getElementById('admin-space-section').classList.add('hidden');
            document.getElementById('logs-space-section').classList.add('hidden');
            document.getElementById('login-matricule').value = '';

            showToast('Session fermée.', 'info');
        }

        function switchTab(tabName) {
            if (tabName !== 'my-space' && originalLeadUser) {
                currentUser = originalLeadUser;
                originalLeadUser = null;
                document.getElementById('user-display-name').innerHTML = `
                    ${currentUser.name} 
                    <i class="fa-solid fa-crown text-amber-400"></i>
                `;
                document.getElementById('user-display-role').innerText = `Matricule: ${currentUser.matricule} | Rôle: ${getRoleLabel(currentUser.role)}`;
                showToast(`Retour à votre session Superviseur (${currentUser.name})`, 'info');
            }

            const tabs = ['my-space', 'admin-space', 'logs-space'];
            tabs.forEach(t => {
                const sec = document.getElementById(`${t}-section`);
                const btn = document.getElementById(`tab-${t}`);
                const mobBtn = document.getElementById(`mobile-tab-${t}`);

                if (t === tabName) {
                    if (sec) sec.classList.remove('hidden');
                    if (btn) {
                        btn.classList.add('bg-brand-600', 'text-white');
                        btn.classList.remove('text-gray-400');
                    }
                    if (mobBtn) {
                        mobBtn.classList.add('text-brand-500');
                        mobBtn.classList.remove('text-gray-400');
                    }
                } else {
                    if (sec) sec.classList.add('hidden');
                    if (btn) {
                        btn.classList.remove('bg-brand-600', 'text-white');
                        btn.classList.add('text-gray-400');
                    }
                    if (mobBtn) {
                        mobBtn.classList.remove('text-brand-500');
                        mobBtn.classList.add('text-gray-400');
                    }
                }
            });

            if (tabName === 'my-space') renderAgentSpace();
