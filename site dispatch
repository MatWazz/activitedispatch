        function exportPaySummary() {
            const { monday, sunday } = getWeekRange(currentWeekOffset);
            const agents = getAgents();
            const shifts = getShifts();

            let summaryText = `=== RÉCAPITULATIF DES PAIES DISPATCH ===\n`;
            summaryText += `Période : ${formatDateFr(monday)} au ${formatDateFr(sunday)}\n\n`;

            let grandTotal = 0;

            agents.forEach(agent => {
                const agentShifts = shifts.filter(s => s.matricule === agent.matricule && isDateInWeek(s.date, monday, sunday));
                let stdH = 0;
                let nightH = 0;
                let pay = 0;

                agentShifts.forEach(s => {
                    const dt = calculateShiftDetails(s.startTime, s.endTime);
                    stdH += dt.stdHours;
                    nightH += dt.nightHours;
                    pay += dt.totalPay;
                });

                if (pay > 0) {
                    summaryText += `• [${agent.matricule}] ${agent.name} : ${stdH.toFixed(1)}h Std + ${nightH.toFixed(1)}h Nuit => TOTAL : ${pay.toLocaleString('fr-FR')} $\n`;
                    grandTotal += pay;
                }
            });

            summaryText += `\nMASSE SALARIALE TOTALE : ${grandTotal.toLocaleString('fr-FR')} $`;

            const textarea = document.createElement('textarea');
            textarea.value = summaryText;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);

            showToast('Récapitulatif copié dans le presse-papier !', 'success');
        }

        function renderLogsSpace() {
            const logs = getLogs();
            const tbody = document.getElementById('logs-tbody');
            if (!tbody) return;
            tbody.innerHTML = '';

            logs.forEach(log => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-dark-900/40 border-b border-gray-800/40';
                tr.innerHTML = `
                    <td class="py-2.5 px-4 text-gray-400">${log.timestamp}</td>
                    <td class="py-2.5 px-4 font-bold text-white">${log.author}</td>
                    <td class="py-2.5 px-4">
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-dark-900 border border-gray-700 text-brand-400">${log.action}</span>
                    </td>
                    <td class="py-2.5 px-4 text-gray-300">${log.details}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            const bgColors = {
                success: 'bg-emerald-950/90 border-emerald-500/50 text-emerald-200',
                error: 'bg-red-950/90 border-red-500/50 text-red-200',
                info: 'bg-brand-950/90 border-brand-500/50 text-brand-200'
            };

            const icons = {
                success: 'fa-circle-check text-emerald-400',
                error: 'fa-circle-xmark text-red-400',
                info: 'fa-circle-info text-brand-400'
            };

            toast.className = `p-4 rounded-xl border shadow-xl backdrop-blur-md flex items-center gap-3 text-xs font-medium transform transition-all duration-300 translate-y-2 opacity-0 ${bgColors[type] || bgColors.info}`;
            toast.innerHTML = `
                <i class="fa-solid ${icons[type] || icons.info} text-base"></i>
                <span class="flex-1">${message}</span>
            `;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }

        window.onload = function() {
            if (!localStorage.getItem(STORAGE_KEY_AGENTS)) {
                saveAgents(DEFAULT_AGENTS);
            } else {
                const currentAgents = JSON.parse(localStorage.getItem(STORAGE_KEY_AGENTS) || '[]');
                if (currentAgents.length === 0) {
                    saveAgents(DEFAULT_AGENTS);
                }
            }

            if (!localStorage.getItem(STORAGE_KEY_SHIFTS)) {
                generateMockShifts();
            }
            if (!localStorage.getItem(STORAGE_KEY_ROLE_NAMES)) {
                saveRoleNames(DEFAULT_ROLE_NAMES);
            }
            if (!localStorage.getItem(STORAGE_KEY_ROLE_COLORS)) {
                saveRoleColors(DEFAULT_ROLE_COLORS);
            }
            if (!localStorage.getItem(STORAGE_KEY_ROLE_PERMS)) {
                saveRolePermissions(DEFAULT_ROLE_PERMS);
            }

            const colorPicker = document.getElementById('new-role-color');
            if (colorPicker) {
                colorPicker.addEventListener('input', (e) => {
                    const hex = e.target.value;
                    const preview = document.getElementById('new-role-badge-preview');
                    if (preview) {
                        preview.style.backgroundColor = `${hex}20`;
                        preview.style.color = hex;
                        preview.style.borderColor = `${hex}50`;
                    }
                });
            }

            updateWeekHeader();
        };
    </script>
</body>
</html>
