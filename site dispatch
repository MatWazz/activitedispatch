<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dispatch Ops Hub - Suivi de Service & Paie</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            500: '#0066ff',
                            600: '#0052cc',
                            700: '#003d99',
                            900: '#001a40',
                        },
                        dark: {
                            900: '#0B0F17',
                            800: '#111827',
                            700: '#1F2937',
                            600: '#374151',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0B0F17;
            color: #F3F4F6;
        }
        .font-mono {
            font-family: 'JetBrains Mono', monospace;
        }
        .glow-effect {
            box-shadow: 0 0 25px -5px rgba(0, 102, 255, 0.25);
        }
        .glow-gold {
            box-shadow: 0 0 25px -5px rgba(234, 179, 8, 0.25);
        }
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #111827;
        }
        ::-webkit-scrollbar-thumb {
            background: #374151;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #4B5563;
        }
    </style>
</head>
<body class="bg-dark-900 text-gray-100 min-h-screen flex flex-col justify-between selection:bg-brand-500 selection:text-white">

    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none"></div>

    <!-- Confirmation Modal replacing alert/confirm -->
    <div id="confirm-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm hidden">
        <div class="bg-dark-800 border border-gray-700 rounded-2xl p-6 max-w-sm w-full mx-4 shadow-2xl">
            <div class="w-12 h-12 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 flex items-center justify-center mb-4 text-xl">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h3 id="confirm-modal-title" class="text-lg font-bold text-white mb-2">Confirmation requise</h3>
            <p id="confirm-modal-msg" class="text-xs text-gray-400 mb-6">Êtes-vous sûr de vouloir effectuer cette action ?</p>
            <div class="flex gap-3">
                <button id="confirm-modal-cancel" class="flex-1 py-2.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded-xl text-xs font-semibold transition">Annuler</button>
                <button id="confirm-modal-btn" class="flex-1 py-2.5 bg-red-600 hover:bg-red-500 text-white rounded-xl text-xs font-semibold transition">Confirmer</button>
            </div>
        </div>
    </div>

    <header id="main-header" class="hidden bg-dark-800/80 backdrop-blur-md border-b border-gray-800 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Logo & Title -->
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-blue-400 flex items-center justify-center shadow-lg shadow-brand-500/30">
                        <i class="fa-solid fa-headset text-xl text-white"></i>
                    </div>
                    <div>
                        <h1 class="text-lg font-bold tracking-wider uppercase text-white flex items-center gap-2">
                            ACTIVITÉ <span class="text-brand-500">DISPATCH</span>
                        </h1>
                        <p class="text-xs text-gray-400">Système de Suivi & Rémunération</p>
                    </div>
                </div>

                <!-- Navigation Tabs -->
                <nav id="nav-tabs" class="hidden md:flex space-x-1 bg-dark-900/60 p-1 rounded-xl border border-gray-800">
                    <button onclick="switchTab('my-space')" id="tab-my-space" class="px-4 py-2 rounded-lg text-sm font-medium transition-all text-white bg-brand-600">
                        <i class="fa-solid fa-user-clock mr-2"></i>Mon Espace Service
                    </button>
                    <button onclick="switchTab('admin-space')" id="tab-admin-space" class="hidden px-4 py-2 rounded-lg text-sm font-medium text-gray-400 hover:text-white transition-all">
                        <i class="fa-solid fa-shield-halved mr-2"></i>Gestion Global Lead
                    </button>
                    <button onclick="switchTab('logs-space')" id="tab-logs-space" class="hidden px-4 py-2 rounded-lg text-sm font-medium text-gray-400 hover:text-white transition-all">
                        <i class="fa-solid fa-list-check mr-2"></i>Journal des Logs
                    </button>
                </nav>

                <!-- User Info & Logout -->
                <div class="flex items-center space-x-4">
                    <div class="text-right">
                        <div id="user-display-name" class="text-sm font-bold text-white flex items-center gap-2 justify-end"></div>
                        <div id="user-display-role" class="text-xs font-mono text-gray-400"></div>
                    </div>
                    <button onclick="logout()" class="p-2.5 text-gray-400 hover:text-red-400 hover:bg-red-500/10 rounded-xl transition-all border border-gray-800 hover:border-red-500/20" title="Déconnexion">
                        <i class="fa-solid fa-power-off text-lg"></i>
                    </button>
                </div>
            </div>
        </div>
        <!-- Mobile Navigation -->
        <div id="mobile-nav" class="md:hidden border-t border-gray-800 bg-dark-800 px-4 py-2 flex justify-around">
            <button onclick="switchTab('my-space')" id="mobile-tab-my-space" class="text-xs text-brand-500 font-medium flex flex-col items-center py-1">
                <i class="fa-solid fa-user-clock text-base mb-1"></i>Mon Espace
            </button>
            <button onclick="switchTab('admin-space')" id="mobile-tab-admin-space" class="hidden text-xs text-gray-400 font-medium flex flex-col items-center py-1">
                <i class="fa-solid fa-shield-halved text-base mb-1"></i>Gestion Lead
            </button>
            <button onclick="switchTab('logs-space')" id="mobile-tab-logs-space" class="hidden text-xs text-gray-400 font-medium flex flex-col items-center py-1">
                <i class="fa-solid fa-list-check text-base mb-1"></i>Logs
            </button>
        </div>
    </header>

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- ================= LOGIN SCREEN ================= -->
        <section id="login-section" class="flex items-center justify-center min-h-[75vh]">
            <div class="w-full max-w-md bg-dark-800 border border-gray-800 rounded-2xl p-8 shadow-2xl glow-effect relative overflow-hidden">
                <div class="absolute -top-12 -right-12 w-32 h-32 bg-brand-600/10 rounded-full blur-2xl"></div>
                <div class="absolute -bottom-12 -left-12 w-32 h-32 bg-blue-600/10 rounded-full blur-2xl"></div>

                <div class="text-center mb-8 relative">
                    <div class="w-16 h-16 rounded-2xl bg-brand-600/10 border border-brand-500/30 flex items-center justify-center mx-auto mb-4 text-brand-500">
                        <i class="fa-solid fa-id-card text-3xl"></i>
                    </div>
                    <h2 class="text-2xl font-bold text-white tracking-tight">Authentification Agent</h2>
                    <p class="text-sm text-gray-400 mt-1">Saisissez votre matricule pour accéder à votre fiche</p>
                </div>

                <form onsubmit="handleLogin(event)" class="space-y-5 relative">
                    <div>
                        <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Matricule Agent</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-500">
                                <i class="fa-solid fa-fingerprint"></i>
                            </span>
                            <input type="text" id="login-matricule" placeholder="Ex: 101, LEAD01..." required
                                class="w-full pl-10 pr-4 py-3 bg-dark-900 border border-gray-700 rounded-xl text-white placeholder-gray-600 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 font-mono text-lg transition-all uppercase">
                        </div>
                    </div>

                    <button type="submit" 
                        class="w-full py-3.5 px-4 bg-gradient-to-r from-brand-600 to-blue-600 hover:from-brand-500 hover:to-blue-500 text-white font-semibold rounded-xl transition-all shadow-lg shadow-brand-600/30 flex items-center justify-center gap-2 group">
                        <span>Se connecter</span>
                        <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                    </button>
                </form>

                <div class="mt-8 pt-6 border-t border-gray-800/80 text-center text-xs text-gray-500">
                    <p class="font-medium">Comptes de démonstration pré-configurés :</p>
                    <div class="flex flex-wrap justify-center gap-2 mt-2 font-mono">
                        <span onclick="setLoginMatricule('101')" class="cursor-pointer px-2 py-1 bg-dark-900 hover:bg-gray-800 rounded border border-gray-800 hover:border-gray-700 transition">101</span>
                        <span onclick="setLoginMatricule('102')" class="cursor-pointer px-2 py-1 bg-dark-900 hover:bg-gray-800 rounded border border-gray-800 hover:border-gray-700 transition">102</span>
                        <span onclick="setLoginMatricule('LEAD01')" class="cursor-pointer px-2 py-1 bg-brand-900/30 text-brand-400 hover:bg-brand-900/50 rounded border border-brand-800/50 transition">LEAD01</span>
                        <span onclick="setLoginMatricule('COLEAD01')" class="cursor-pointer px-2 py-1 bg-brand-900/30 text-brand-400 hover:bg-brand-900/50 rounded border border-brand-800/50 transition">COLEAD01</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= AGENT SPACE (MY SPACE) ================= -->
        <section id="my-space-section" class="hidden space-y-8">
            <div class="bg-dark-800 border border-gray-800 rounded-2xl p-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h2 class="text-xl font-bold text-white flex items-center gap-2">
                        <span>Fiche Agent :</span>
                        <span id="agent-profile-name" class="text-brand-500">---</span>
                    </h2>
                    <p class="text-xs text-gray-400 mt-1">Saisie des sessions de service Dispatch et décompte hebdomadaire de rémunération.</p>
                </div>

                <!-- Week Selector Navigation -->
                <div class="flex items-center space-x-3 bg-dark-900 p-1.5 rounded-xl border border-gray-800 self-start md:self-auto">
                    <button onclick="changeWeek(-1)" class="p-2 hover:bg-dark-800 text-gray-400 hover:text-white rounded-lg transition" title="Semaine précédente">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <div class="text-center px-3">
                        <span id="current-week-label" class="text-xs font-semibold uppercase tracking-wider text-gray-400 block">Semaine</span>
                        <span id="current-week-dates" class="text-xs font-mono text-brand-400">01/01 - 07/01</span>
                    </div>
                    <button onclick="changeWeek(1)" class="p-2 hover:bg-dark-800 text-gray-400 hover:text-white rounded-lg transition" title="Semaine suivante">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                    <button onclick="resetToCurrentWeek()" class="px-2.5 py-1 text-xs bg-gray-800 hover:bg-gray-700 text-gray-300 rounded-lg transition font-medium">Aujourd'hui</button>
                </div>
            </div>

            <!-- Stats Overview Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-dark-800 border border-gray-800 rounded-2xl p-5 relative overflow-hidden">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs font-semibold uppercase text-gray-400">Total Heures Service</p>
                            <h3 id="stat-total-hours" class="text-2xl font-extrabold font-mono text-white mt-2">0.0 h</h3>
                        </div>
                        <div class="p-3 bg-blue-500/10 text-blue-400 rounded-xl border border-blue-500/20">
                            <i class="fa-solid fa-clock text-xl"></i>
                        </div>
                    </div>
                    <p class="text-xs text-gray-500 mt-3 flex items-center gap-1">
                        <i class="fa-solid fa-calendar-week"></i> Sur la semaine sélectionnée
                    </p>
                </div>

                <div class="bg-dark-800 border border-gray-800 rounded-2xl p-5 relative overflow-hidden">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs font-semibold uppercase text-gray-400">Tranche Jour (00h-21h)</p>
                            <h3 id="stat-std-hours" class="text-2xl font-extrabold font-mono text-emerald-400 mt-2">0.0 h</h3>
                            <p id="stat-std-pay" class="text-xs font-mono text-emerald-500/80 font-medium mt-0.5">0 $ (1000$/h)</p>
                        </div>
                        <div class="p-3 bg-emerald-500/10 text-emerald-400 rounded-xl border border-emerald-500/20">
                            <i class="fa-solid fa-sun text-xl"></i>
                        </div>
                    </div>
                </div>

                <div class="bg-dark-800 border border-gray-800 rounded-2xl p-5 relative overflow-hidden">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs font-semibold uppercase text-gray-400">Tranche Nuit (21h-00h)</p>
                            <h3 id="stat-night-hours" class="text-2xl font-extrabold font-mono text-purple-400 mt-2">0.0 h</h3>
                            <p id="stat-night-pay" class="text-xs font-mono text-purple-500/80 font-medium mt-0.5">0 $ (2000$/h)</p>
                        </div>
                        <div class="p-3 bg-purple-500/10 text-purple-400 rounded-xl border border-purple-500/20">
                            <i class="fa-solid fa-moon text-xl"></i>
                        </div>
                    </div>
                </div>

                <div class="bg-dark-800 border border-gray-800 rounded-2xl p-5 relative overflow-hidden glow-gold border-amber-500/30">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs font-semibold uppercase text-amber-400/80">Rémunération Totale</p>
                            <h3 id="stat-total-pay" class="text-3xl font-extrabold font-mono text-amber-400 mt-2">0 $</h3>
                        </div>
                        <div class="p-3 bg-amber-500/10 text-amber-400 rounded-xl border border-amber-500/20">
                            <i class="fa-solid fa-sack-dollar text-xl"></i>
                        </div>
                    </div>
                    <p class="text-xs text-amber-500/70 mt-2 font-medium">Cumul calculé automatiquement</p>
                </div>
            </div>

            <!-- Form & Table Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Left: Add Shift Form -->
                <div class="lg:col-span-1">
                    <div class="bg-dark-800 border border-gray-800 rounded-2xl p-6 sticky top-24">
                        <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
                            <i class="fa-solid fa-plus-circle text-brand-500"></i>
                            Saisir un Service
                        </h3>

                        <form onsubmit="handleSaveShift(event)" class="space-y-4">
                            <input type="hidden" id="shift-id">
                            
                            <div>
                                <label class="block text-xs font-semibold text-gray-400 uppercase mb-1">Date du service</label>
                                <input type="date" id="shift-date" required
                                    class="w-full bg-dark-900 border border-gray-700 rounded-xl px-3.5 py-2.5 text-white focus:outline-none focus:border-brand-500 font-mono text-sm">
                            </div>

                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-xs font-semibold text-gray-400 uppercase mb-1">Prise (Début)</label>
                                    <input type="time" id="shift-start" required
                                        class="w-full bg-dark-900 border border-gray-700 rounded-xl px-3.5 py-2.5 text-white focus:outline-none focus:border-brand-500 font-mono text-sm">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-gray-400 uppercase mb-1">Fin de Service</label>
                                    <input type="time" id="shift-end" required
                                        class="w-full bg-dark-900 border border-gray-700 rounded-xl px-3.5 py-2.5 text-white focus:outline-none focus:border-brand-500 font-mono text-sm">
                                </div>
                            </div>

                            <div class="p-3 bg-dark-900/80 rounded-xl border border-gray-800 text-xs text-gray-400 space-y-1">
                                <div class="flex justify-between">
                                    <span>Taux Jour (00h-21h) :</span>
                                    <span class="font-mono text-emerald-400">1 000 $/h</span>
                                </div>
                                <div class="flex justify-between">
                                    <span>Taux Nuit (21h-00h) :</span>
                                    <span class="font-mono text-purple-400">2 000 $/h</span>
                                </div>
                            </div>

                            <div class="flex gap-2 pt-2">
                                <button type="submit" id="btn-save-shift"
                                    class="flex-1 bg-brand-600 hover:bg-brand-500 text-white font-semibold py-3 px-4 rounded-xl transition shadow-lg shadow-brand-600/20 text-sm flex items-center justify-center gap-2">
                                    <i class="fa-solid fa-check"></i> Enregistrer le Service
                                </button>
                                <button type="button" id="btn-cancel-edit" onclick="resetShiftForm()" class="hidden bg-gray-700 hover:bg-gray-600 text-white px-3 rounded-xl transition">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Right: Shifts History Table for current week -->
                <div class="lg:col-span-2 space-y-4">
                    <div class="bg-dark-800 border border-gray-800 rounded-2xl overflow-hidden">
                        <div class="p-5 border-b border-gray-800 flex items-center justify-between">
                            <h3 class="text-base font-bold text-white flex items-center gap-2">
                                <i class="fa-solid fa-list-ul text-brand-500"></i>
                                Historique des Prises de Service
                            </h3>
                            <span id="shift-count-badge" class="text-xs bg-dark-900 text-gray-400 border border-gray-700 px-2.5 py-1 rounded-full font-mono">0 entrée(s)</span>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-sm">
                                <thead class="bg-dark-900/50 text-gray-400 uppercase text-[11px] font-semibold tracking-wider border-b border-gray-800">
                                    <tr>
                                        <th class="py-3 px-4">Date</th>
                                        <th class="py-3 px-4">Horaires</th>
                                        <th class="py-3 px-4">Durée Total</th>
                                        <th class="py-3 px-4">Ventilation (Jour / Nuit)</th>
                                        <th class="py-3 px-4 text-right">Rémunération</th>
                                        <th class="py-3 px-4 text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="shifts-tbody" class="divide-y divide-gray-800/60 font-mono text-xs">
                                    <!-- Dynamic rows -->
                                </tbody>
                            </table>
                        </div>

                        <div id="shifts-empty" class="p-8 text-center text-gray-500">
                            <i class="fa-regular fa-folder-open text-3xl mb-2 block text-gray-600"></i>
                            Aucune prise de service enregistrée pour cette semaine.
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= LEAD / ADMIN SPACE ================= -->
        <section id="admin-space-section" class="hidden space-y-8">
            <div class="bg-dark-800 border border-gray-800 rounded-2xl p-6">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <h2 class="text-xl font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-crown text-amber-400"></i>
                            <span>Espace de Supervision Lead & Co-Lead</span>
                        </h2>
                        <p class="text-xs text-gray-400 mt-1">Vue consolidée de l'effectif, récapitulatif financier, gestion des rôles et des accès.</p>
                    </div>

                    <div class="flex items-center space-x-3 bg-dark-900 p-1.5 rounded-xl border border-gray-800">
                        <button onclick="changeWeek(-1)" class="p-2 hover:bg-dark-800 text-gray-400 hover:text-white rounded-lg transition">
                            <i class="fa-solid fa-chevron-left"></i>
                        </button>
                        <div class="text-center px-3">
                            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block">Période</span>
                            <span id="admin-week-dates" class="text-xs font-mono text-brand-400">01/01 - 07/01</span>
                        </div>
                        <button onclick="changeWeek(1)" class="p-2 hover:bg-dark-800 text-gray-400 hover:text-white rounded-lg transition">
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- KPI Cards -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <div class="bg-dark-800 border border-gray-800 rounded-2xl p-5">
                    <p class="text-xs font-semibold uppercase text-gray-400">Effectif Recensé</p>
                    <h3 id="admin-stat-agents" class="text-3xl font-extrabold font-mono text-white mt-2">0</h3>
                    <p class="text-xs text-gray-500 mt-1">Dispatchers enregistrés sur le site</p>
                </div>
                <div class="bg-dark-800 border border-gray-800 rounded-2xl p-5">
                    <p class="text-xs font-semibold uppercase text-gray-400">Heures Totales Servies</p>
                    <h3 id="admin-stat-hours" class="text-3xl font-extrabold font-mono text-blue-400 mt-2">0.0 h</h3>
                    <p class="text-xs text-gray-500 mt-1">Cumul global sur la semaine</p>
                </div>
                <div class="bg-dark-800 border border-gray-800 rounded-2xl p-5 glow-gold border-amber-500/20">
                    <p class="text-xs font-semibold uppercase text-amber-400">Masse Salariale Semaine</p>
                    <h3 id="admin-stat-payout" class="text-3xl font-extrabold font-mono text-amber-400 mt-2">0 $</h3>
                    <p class="text-xs text-amber-500/60 mt-1">Montant global à rémunérer</p>
                </div>
            </div>

            <!-- Subtabs navigation -->
            <div class="flex border-b border-gray-800 space-x-6 text-sm font-semibold overflow-x-auto">
                <button onclick="toggleAdminSubTab('summary')" id="subtab-btn-summary" class="pb-3 border-b-2 border-brand-500 text-brand-400 whitespace-nowrap">
                    <i class="fa-solid fa-table-list mr-2"></i>Récapitulatif des Paies Agents
                </button>
                <button onclick="toggleAdminSubTab('agents')" id="subtab-btn-agents" class="pb-3 border-b-2 border-transparent text-gray-400 hover:text-white whitespace-nowrap">
                    <i class="fa-solid fa-users-gear mr-2"></i>Gestion de l'Effectif
                </button>
                <button onclick="toggleAdminSubTab('roles')" id="subtab-btn-roles" class="pb-3 border-b-2 border-transparent text-gray-400 hover:text-white whitespace-nowrap">
                    <i class="fa-solid fa-tags mr-2"></i>Configuration des Rôles & Accès
                </button>
            </div>

            <!-- Subtab 1: Summary -->
