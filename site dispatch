        function editAgent(matricule) {
            const agents = getAgents();
            const agent = agents.find(a => a.matricule === matricule);
            if (!agent) return;

            document.getElementById('agent-form-matricule').value = agent.matricule;
            document.getElementById('agent-form-matricule').readOnly = true;
            document.getElementById('agent-form-name').value = agent.name;
            document.getElementById('agent-form-role').value = agent.role;

            const formTitle = document.querySelector('#admin-subtab-agents .lg\\:col-span-1 h3');
            if (formTitle) formTitle.innerHTML = '<i class="fa-solid fa-user-pen text-brand-500"></i> Modifier l\'Agent';
            
            window.scrollTo({ top: 0, behavior: 'smooth' });
