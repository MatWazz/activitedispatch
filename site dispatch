        function renderAgentSpace() {
            if (!currentUser) return;
            updateWeekHeader();
            document.getElementById('agent-profile-name').innerText = `${currentUser.name} (${currentUser.matricule}) - ${getRoleLabel(currentUser.role)}`;

            const dateInput = document.getElementById('shift-date');
            if (!dateInput.value) {
                dateInput.value = new Date().toISOString().split('T')[0];
            }

            const { monday, sunday } = getWeekRange(currentWeekOffset);
            const shifts = getShifts().filter(s => s.matricule === currentUser.matricule);
            const weekShifts = shifts.filter(s => isDateInWeek(s.date, monday, sunday));

            let totalH = 0;
            let stdH = 0;
            let nightH = 0;
            let totalP = 0;
            let stdP = 0;
            let nightP = 0;

            weekShifts.forEach(s => {
                const dt = calculateShiftDetails(s.startTime, s.endTime);
                totalH += dt.totalHours;
                stdH += dt.stdHours;
                nightH += dt.nightHours;
                totalP += dt.totalPay;
                stdP += dt.stdPay;
                nightP += dt.nightPay;
            });

            document.getElementById('stat-total-hours').innerText = totalH.toFixed(1) + ' h';
            document.getElementById('stat-std-hours').innerText = stdH.toFixed(1) + ' h';
            document.getElementById('stat-std-pay').innerText = stdP.toLocaleString('fr-FR') + ' $ (1000$/h)';
            document.getElementById('stat-night-hours').innerText = nightH.toFixed(1) + ' h';
            document.getElementById('stat-night-pay').innerText = nightP.toLocaleString('fr-FR') + ' $ (2000$/h)';
            document.getElementById('stat-total-pay').innerText = totalP.toLocaleString('fr-FR') + ' $';
            document.getElementById('shift-count-badge').innerText = weekShifts.length + ' entrée(s)';

            const tbody = document.getElementById('shifts-tbody');
            tbody.innerHTML = '';
            const emptyDiv = document.getElementById('shifts-empty');

            if (weekShifts.length === 0) {
                emptyDiv.classList.remove('hidden');
            } else {
                emptyDiv.classList.add('hidden');
                weekShifts.forEach(s => {
                    const dt = calculateShiftDetails(s.startTime, s.endTime);
                    const tr = document.createElement('tr');
                    tr.className = 'hover:bg-dark-900/40 border-b border-gray-800/50';
                    tr.innerHTML = `
                        <td class="py-3 px-4 text-white font-bold">${s.date}</td>
                        <td class="py-3 px-4 text-brand-400 font-mono"><i class="fa-solid fa-clock mr-1 text-[10px]"></i>${s.startTime} - ${s.endTime}</td>
                        <td class="py-3 px-4 text-white font-bold">${dt.totalHours} h</td>
                        <td class="py-3 px-4">
                            <span class="text-emerald-400">${dt.stdHours}h Std</span> / 
                            <span class="text-purple-400">${dt.nightHours}h Nuit</span>
                        </td>
                        <td class="py-3 px-4 text-right text-amber-400 font-bold">${dt.totalPay.toLocaleString('fr-FR')} $</td>
                        <td class="py-3 px-4 text-center">
                            <div class="flex items-center justify-center gap-1.5">
                                <button onclick="editShift('${s.id}')" class="p-1.5 bg-blue-500/10 hover:bg-blue-500/20 text-blue-400 rounded-lg transition" title="Modifier">
                                    <i class="fa-solid fa-pen text-xs"></i>
                                </button>
                                <button onclick="deleteShift('${s.id}')" class="p-1.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-lg transition" title="Supprimer">
                                    <i class="fa-solid fa-trash text-xs"></i>
                                </button>
                            </div>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            }
        }

        function handleSaveShift(e) {
            e.preventDefault();
            if (!currentUser) return;

            const id = document.getElementById('shift-id').value;
            const date = document.getElementById('shift-date').value;
            const startTime = document.getElementById('shift-start').value;
            const endTime = document.getElementById('shift-end').value;

            if (!date || !startTime || !endTime) {
                showToast('Veuillez remplir tous les champs du service.', 'error');
                return;
            }

            let shifts = getShifts();

            if (id) {
                shifts = shifts.map(s => s.id === id ? { ...s, date, startTime, endTime } : s);
                addLog('MODIF_SHIFT', `Service modifié pour ${currentUser.name} (${date} ${startTime}-${endTime})`);
                showToast('Service mis à jour avec succès.', 'success');
            } else {
                const newShift = {
                    id: 'shift_' + Date.now(),
                    matricule: currentUser.matricule,
                    date,
                    startTime,
                    endTime
                };
                shifts.push(newShift);
                addLog('AJOUT_SHIFT', `Nouveau service enregistré pour ${currentUser.name} (${date} ${startTime}-${endTime})`);
                showToast('Service enregistré avec succès.', 'success');
            }

            saveShifts(shifts);
            resetShiftForm();
            renderAgentSpace();
        }

